{
  "platform_name": "xiaohongshu",
  "display_name": "小红书",
  "base_url": "https://creator.xiaohongshu.com",
  "login_url": "https://creator.xiaohongshu.com/login",
  "publish_url": "https://creator.xiaohongshu.com/publish",
  "supported_formats": {
    "video": ["mp4", "mov"],
    "image": ["jpg", "png"]
  },
  "max_file_size": {
    "video": 1073741824,
    "image": 10485760
  },
  "upload_timeout": 1800,
  "publish_interval": {
    "min": 60,
    "max": 300
  },
  "selectors_file": "config/selectors/xiaohongshu_selectors.json",
  "status": "reserved",
  "anti_risk": {
    "delay_jitter_ratio": 0.15,
    "step_interval_base_seconds": 0.2,
    "step_interval_jitter_seconds": 0.4,
    "enable_human_like": true,
    "enable_mouse_wander": true,
    "enable_browse_before_action": true,
    "browse_probability": 0.25,
    "operation_delay_min_seconds": 0.4,
    "operation_delay_max_seconds": 2.0,
    "operation_delay_before_click": true,
    "operation_delay_before_type": true,
    "type_mistake_probability": 0.02
  }
}

