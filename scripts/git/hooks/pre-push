#!/bin/sh
# 阻止：git push public main（会把闭源代码推到公开仓）
# 允许：git push public oss-release:main（由 publish_oss_to_public 脚本生成）
# 安装：.\scripts\git\install_git_hooks.ps1

remote="$1"

if [ "$remote" != "public" ]; then
  exit 0
fi

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_ref" = "refs/heads/main" ]; then
    echo "" >&2
    echo "[错误] 禁止：git push public main（会把闭源推到公开仓）" >&2
    echo "       请改用：.\\scripts\\git\\publish_oss_to_public.ps1" >&2
    echo "       或双击：scripts\\git\\publish_oss_to_public.bat" >&2
    echo "" >&2
    exit 1
  fi
done

exit 0
