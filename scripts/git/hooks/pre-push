#!/bin/sh
# Block accidental pushes to public (Windows Git may not pass refs on stdin).
# Only publish_oss_to_public.ps1 sets ALLOW_PUBLIC_OSS_PUSH=1 before push.

remote="$1"

if [ "$remote" != "public" ]; then
  exit 0
fi

if [ "$ALLOW_PUBLIC_OSS_PUSH" = "1" ]; then
  exit 0
fi

echo "" >&2
echo "[ERROR] Blocked: push to remote 'public'" >&2
echo "        Do not use: git push public main" >&2
echo "        Use: .\\scripts\\git\\publish_oss_to_public.ps1" >&2
echo "        Or:  scripts\\git\\publish_oss_to_public.bat" >&2
echo "" >&2
exit 1
